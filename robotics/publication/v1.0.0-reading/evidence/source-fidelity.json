  "adapter_declarations": [
    {
      "kind": "source-target",
      "id": "sec01",
      "target_type": "Header",
      "target_text": "01　定位、目标与关键决定"
    },
    {
      "kind": "source-target",
      "id": "sec02",
      "target_type": "Header",
      "target_text": "02　能力地图：先补什么，后深入什么"
    },
    {
      "kind": "source-target",
      "id": "sec03",
      "target_type": "Header",
      "target_text": "03　系统模型：物理、控制与智能各司其职"
    },
    {
      "kind": "source-target",
      "id": "sec04",
      "target_type": "Header",
      "target_text": "04　学习协议、投入方式与验收规则"
    },
    {
      "kind": "source-target",
      "id": "sec05",
      "target_type": "Header",
      "target_text": "05　硬件选择：一个 MCU 生态，一套可调试工具"
    },
    {
      "kind": "source-target",
      "id": "sec06",
      "target_type": "Header",
      "target_text": "06　分批采购、参考组合与兼容性检查"
    },
    {
      "kind": "source-target",
      "id": "sec07",
      "target_type": "Header",
      "target_text": "07　开发环境、计算平台与版本策略"
    },
    {
      "kind": "source-target",
      "id": "sec08",
      "target_type": "Header",
      "target_text": "08　R0：电气基础与可调试执行"
    },
    {
      "kind": "source-target",
      "id": "sec09",
      "target_type": "Header",
      "target_text": "09　R1：认识电机、编码器与测量误差"
    },
    {
      "kind": "source-target",
      "id": "sec10",
      "target_type": "Header",
      "target_text": "10　R2：从模型到闭环控制"
    },
    {
      "kind": "source-target",
      "id": "sec11",
      "target_type": "Header",
      "target_text": "11　R3：可靠固件与本地故障响应"
    },
    {
      "kind": "source-target",
      "id": "sec12",
      "target_type": "Header",
      "target_text": "12　R4：坐标、感知、时间与状态估计"
    },
    {
      "kind": "source-target",
      "id": "sec13",
      "target_type": "Header",
      "target_text": "13　R5：ROS 2、仿真与真实硬件集成"
    },
    {
      "kind": "source-target",
      "id": "sec14",
      "target_type": "Header",
      "target_text": "14　R6：桌面机器宠物原型"
    },
    {
      "kind": "source-target",
      "id": "sec15",
      "target_type": "Header",
      "target_text": "15　R7：数据、模仿学习与任务评测"
    },
    {
      "kind": "source-target",
      "id": "sec16",
      "target_type": "Header",
      "target_text": "16　前沿研究地图：跟问题，不只跟模型名"
    },
    {
      "kind": "source-target",
      "id": "sec17",
      "target_type": "Header",
      "target_text": "17　分支选择：不把所有机器人都做一遍"
    },
    {
      "kind": "source-target",
      "id": "sec18",
      "target_type": "Header",
      "target_text": "18　实验安全与故障响应边界"
    },
    {
      "kind": "source-target",
      "id": "sec19",
      "target_type": "Header",
      "target_text": "19　验证体系、指标与证据要求"
    },
    {
      "kind": "source-target",
      "id": "sec20",
      "target_type": "Header",
      "target_text": "20　代码组织与学习资产沉淀"
    },
    {
      "kind": "source-target",
      "id": "sec21",
      "target_type": "Header",
      "target_text": "21　推进方式与前十次学习单元"
    },
    {
      "kind": "source-target",
      "id": "sec22",
      "target_type": "Header",
      "target_text": "22　可复用模板：实验、采购与前沿复现"
    },
    {
      "kind": "source-target",
      "id": "sec23",
      "target_type": "Header",
      "target_text": "23　资料使用、维护与版本管理"
    },
